// Cloudflare Workers config: serve this folder as a static site (no build step, no Worker code).
{
  "name": "guava-ventures",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Lets pull-request builds (npx wrangler preview) publish a preview URL.
  "previews": {}
}
